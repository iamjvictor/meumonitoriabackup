# MeuMonitorAI monorepo environment reference.
# The apps load their own files; copy these templates and fill in real values:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env.local
# Never put real credentials in this file.

# Backend: required for the API and workers. See backend/.env.example for the
# full list of optional model, ingestion, payment, and import settings.
NODE_ENV=development
HOST=0.0.0.0
PORT=8443
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_QUESTION_MODEL=google/gemini-2.5-flash
DOCUMENT_VISUAL_ASSETS_ENABLED=false
DOCUMENT_VISUAL_DESCRIPTION_MODEL=google/gemini-2.5-flash
CHAT_IMAGE_INPUT_ENABLED=false
CHAT_IMAGE_MODEL=google/gemini-2.5-flash
# Base64 encoding of exactly 32 random bytes. Keep this secret.
ASAAS_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Frontend: copy these values into frontend/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8443
NEXT_PUBLIC_CHAT_IMAGE_INPUT_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
